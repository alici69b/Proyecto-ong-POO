                </button>
                <button type="button" onclick="confirmarAsignacion()"
                    class="w-full rounded-2xl bg-gradient-to-r from-[#00a5cf] to-[#9fffcb] text-[#004e64] py-3 font-extrabold hover:opacity-90 transition-all">
